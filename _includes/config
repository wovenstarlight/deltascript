<aside id="menu">
	<button id="openmenu">
		<span class="visually-hidden">Config</span>
		<img src="{{ '/assets/images/config/1.png' | relative_url }}" alt="" aria-hidden="true" class="inactive" />
		<img src="{{ '/assets/images/config/0.png' | relative_url }}" alt="" aria-hidden="true" class="active" />
	</button>
	<section class="d-section" id="menucontents" hidden>
		<a href="#sitehead">Back to top</a>

		<label for="toggle-compact" class="toggle" title="Alt + C">
			<input type="checkbox" id="toggle-compact" class="visually-hidden">
			Compact mode
		</label>

		<label for="toggle-dim" class="toggle" title="Alt + M">
			<input type="checkbox" id="toggle-dim" class="visually-hidden">
			Dim colors
		</label>

		<label for="toggle-anim" class="toggle" title="Alt + A">
			<input type="checkbox" id="toggle-anim" class="visually-hidden" checked>
			Animations
		</label>

		<label for="toggle-opendyslexic" class="toggle" title="Alt + X">
			<input type="checkbox" id="toggle-opendyslexic" class="visually-hidden">
			Dyslexia-friendly font
		</label>

		<button id="open-choices" title="Alt + Z">
			Show all choices
		</button>
	</section>
</aside>